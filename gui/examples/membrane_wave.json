{
  "format_version": 3,
  "name": "Membrane: waves from an initial bump, fixed edges (PDE module of order 2 in time, Newmark)",
  "parameters": [
    {
      "name": "c0",
      "value": 1.0,
      "description": "wave speed"
    },
    {
      "name": "r0",
      "value": 0.1,
      "description": "radius of the initial bump"
    }
  ],
  "materials": [],
  "geometries": [
    {
      "name": "membrane",
      "source": {
        "type": "box",
        "origin": [
          0.0,
          0.0
        ],
        "size": [
          1.0,
          1.0
        ]
      },
      "selections": {}
    }
  ],
  "meshes": [
    {
      "name": "mesh",
      "geometry": "membrane",
      "mesher": "structured",
      "divisions": [
        40,
        40
      ],
      "element": "simplex"
    }
  ],
  "fields": [],
  "models": [
    {
      "name": "membrane",
      "variables": [
        {
          "name": "w",
          "mesh": "mesh",
          "fem": "lagrange",
          "degree": 2,
          "initial": "exp(-(sqr(x-0.3) + sqr(y-0.4))/sqr(r0))"
        }
      ],
      "modules": [
        {
          "type": "pde",
          "variable": "w",
          "form": "coefficients",
          "unknown": "scalar",
          "time_order": "2",
          "diffusion": "isotropic",
          "stabilization": "none",
          "properties": {
            "c": [
              {
                "selection": "all",
                "value": "sqr(c0)"
              }
            ],
            "al": [
              {
                "selection": "all",
                "value": [
                  0.0,
                  0.0
                ]
              }
            ],
            "ga": [
              {
                "selection": "all",
                "value": [
                  0.0,
                  0.0
                ]
              }
            ],
            "be": [
              {
                "selection": "all",
                "value": [
                  0.0,
                  0.0
                ]
              }
            ],
            "a": [
              {
                "selection": "all",
                "value": 0.0
              }
            ],
            "ea": [
              {
                "selection": "all",
                "value": 1.0
              }
            ],
            "da": [
              {
                "selection": "all",
                "value": 0.0
              }
            ]
          },
          "sources": [],
          "conditions": [
            {
              "type": "imposed_value",
              "selection": "boundary",
              "value": 0.0
            }
          ]
        }
      ],
      "terms": [],
      "conditions": [],
      "solver": {
        "type": "auto"
      },
      "outputs": [
        {
          "name": "displaced_volume",
          "expr": "w",
          "selection": "all"
        },
        {
          "name": "energy",
          "expr": "0.5*sqr(Dot_w) + 0.5*sqr(c0)*Norm_sqr(Grad_w)",
          "selection": "all"
        }
      ],
      "vtu": "membrane.vtu"
    }
  ],
  "solvers": [
    {
      "name": "waves",
      "type": "transient",
      "steps": [
        "membrane"
      ],
      "time": {
        "start": 0,
        "end": 1.0,
        "step": 0.01
      },
      "save": {
        "every": 2
      },
      "schemes": {
        "membrane/w": {
          "type": "newmark",
          "beta": 0.25,
          "gamma": 0.5
        }
      }
    }
  ],
  "outputs": [],
  "graphics": []
}
