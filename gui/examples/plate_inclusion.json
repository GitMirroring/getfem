{
  "format_version": 3,
  "name": "Plate with a conductive inclusion",
  "parameters": [
    {
      "name": "L",
      "value": 0.1,
      "description": "side of the plate (m)"
    },
    {
      "name": "R",
      "value": 0.025,
      "description": "radius of the inclusion (m)"
    },
    {
      "name": "h",
      "value": "L/40",
      "description": "element size (m)"
    }
  ],
  "materials": [
    {
      "name": "epoxy",
      "properties": {
        "k": 0.2
      }
    },
    {
      "name": "copper",
      "properties": {
        "k": 400.0
      }
    }
  ],
  "geometries": [
    {
      "name": "plate",
      "source": {
        "type": "csg",
        "dim": 2,
        "shape": {
          "type": "union",
          "of": [
            {
              "type": "rectangle",
              "min": [
                0.0,
                0.0
              ],
              "max": [
                "L",
                "L"
              ]
            },
            {
              "type": "ball",
              "center": [
                "L/2",
                "L/2"
              ],
              "radius": "R"
            }
          ]
        }
      },
      "selections": {
        "matrix": {
          "kind": "domain",
          "criteria": {
            "type": "regions",
            "regions": [
              [
                [
                  0
                ]
              ]
            ]
          }
        },
        "inclusion": {
          "kind": "domain",
          "criteria": {
            "type": "regions",
            "regions": [
              [
                [
                  0
                ],
                [
                  1
                ]
              ]
            ]
          }
        },
        "cold": {
          "kind": "boundary",
          "criteria": {
            "type": "edges",
            "edges": [
              {
                "shape": [
                  0
                ],
                "side": "xmin"
              }
            ]
          }
        },
        "hot": {
          "kind": "boundary",
          "criteria": {
            "type": "edges",
            "edges": [
              {
                "shape": [
                  0
                ],
                "side": "xmax"
              }
            ]
          }
        }
      }
    }
  ],
  "meshes": [
    {
      "name": "mesh",
      "geometry": "plate",
      "mesher": "getfem",
      "h": "h",
      "order": 1
    }
  ],
  "models": [
    {
      "name": "heat",
      "variables": [
        {
          "name": "T",
          "mesh": "mesh",
          "fem": "lagrange",
          "degree": 2
        }
      ],
      "modules": [
        {
          "type": "heat_conduction",
          "variable": "T",
          "properties": {
            "k": [
              {
                "selection": "matrix",
                "material": "epoxy"
              },
              {
                "selection": "inclusion",
                "material": "copper"
              }
            ]
          },
          "sources": [],
          "conditions": [
            {
              "type": "temperature",
              "selection": "cold",
              "value": 20.0
            },
            {
              "type": "temperature",
              "selection": "hot",
              "value": 80.0
            }
          ]
        }
      ],
      "terms": [],
      "conditions": [],
      "solver": {
        "type": "auto"
      },
      "outputs": [
        {
          "name": "heat_flow",
          "expr": "-k*Grad_T.Normal",
          "selection": "cold"
        },
        {
          "name": "inclusion_area",
          "expr": "1",
          "selection": "inclusion"
        },
        {
          "name": "mean_T_inclusion",
          "expr": "T / (pi*R*R)",
          "selection": "inclusion"
        }
      ],
      "vtu": "plate_inclusion.vtu"
    }
  ]
}
