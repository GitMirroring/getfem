{
  "format_version": 3,
  "name": "Heated plate cooled by convection",
  "materials": [
    {
      "name": "aluminium",
      "properties": {
        "k": 237.0
      }
    }
  ],
  "geometries": [
    {
      "name": "plate",
      "source": {
        "type": "box",
        "origin": [
          0.0,
          0.0
        ],
        "size": [
          0.2,
          0.1
        ]
      },
      "selections": {
        "convective_edges": {
          "kind": "boundary",
          "criteria": {
            "type": "union",
            "of": [
              "xmax",
              "ymax"
            ]
          }
        }
      }
    }
  ],
  "meshes": [
    {
      "name": "mesh",
      "geometry": "plate",
      "mesher": "structured",
      "divisions": [
        40,
        20
      ],
      "element": "simplex"
    }
  ],
  "models": [
    {
      "name": "heat",
      "variables": [
        {
          "name": "T",
          "mesh": "mesh",
          "fem": "lagrange",
          "degree": 2
        }
      ],
      "modules": [
        {
          "type": "heat_conduction",
          "variable": "T",
          "properties": {
            "k": [
              {
                "selection": "all",
                "material": "aluminium"
              }
            ]
          },
          "sources": [
            {
              "selection": "all",
              "value": "5e5 * exp(-(sqr(x-0.1) + sqr(y-0.05)) / 1e-4)"
            }
          ],
          "conditions": [
            {
              "type": "temperature",
              "selection": "xmin",
              "value": 20.0
            },
            {
              "type": "convection",
              "selection": "convective_edges",
              "h": 25.0,
              "T_ext": 20.0
            }
          ]
        }
      ],
      "terms": [],
      "conditions": [],
      "solver": {
        "type": "auto"
      },
      "outputs": [
        {
          "name": "injected_power",
          "expr": "5e5 * exp(-(sqr(x-0.1) + sqr(y-0.05)) / 1e-4)",
          "selection": "all"
        },
        {
          "name": "outflow_xmin",
          "expr": "-k*Grad_T.Normal",
          "selection": "xmin"
        },
        {
          "name": "outflow_convection",
          "expr": "-k*Grad_T.Normal",
          "selection": "convective_edges"
        },
        {
          "name": "mean_temperature",
          "expr": "T / 0.02",
          "selection": "all"
        }
      ],
      "vtu": "plate.vtu"
    }
  ]
}
